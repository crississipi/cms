# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Environment Configuration Template
# Copy this file to .env and fill in real values before starting the application.
# Never commit real secrets or production credentials to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ==========================================
# 1. Database (Aiven for PostgreSQL with TLS)
# ==========================================
# Primary database URL used by Prisma and the Next.js app.
# Append ?sslmode=require (or &sslmode=no-verify for development without CA bundle).
DTBASE_URL="postgres://avnadmin:your_password@your-pg-instance.aivencloud.com:24838/defaultdb?sslmode=require"

# Direct Database URL (Optional: used for Prisma migrations when DTBASE_URL points to a pooler like PgBouncer)
DIRECT_DTBASE_URL="postgres://avnadmin:your_password@your-pg-instance.aivencloud.com:24838/defaultdb?sslmode=require"

# ==========================================
# 2. HubSpot CRM API Configuration
# ==========================================
# Private App Access Token with scopes:
# - crm.objects.contacts.read
# - crm.objects.contacts.write
# - crm.objects.deals.read
# - crm.objects.deals.write
# - crm.schemas.deals.read
HUBSPOT_ACCESS_TOKEN="pat-na1-your_hubspot_access_token_here"
HUBSPOT_API_VERSION="2026-09"
HUBSPOT_PIPELINE_ID="default"
HUBSPOT_DEAL_STAGE_ID="appointmentscheduled"

# ==========================================
# 3. Webhook Security Configuration
# ==========================================
# Shared secret used to compute and verify HMAC-SHA256 signatures over raw order request bytes.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ORDER_WEBHOOK_SECRET="your_hmac_sha256_shared_secret_hex_at_least_32_characters"

# Header containing the incoming webhook signature (defaults to x-order-signature)
ORDER_SIGNATURE_HEADER="x-order-signature"

# Maximum allowable request body size in bytes (defaults to 65536 = 64KB)
MAX_REQUEST_BYTES="65536"

# ==========================================
# 4. Dashboard Authentication & Sessions
# ==========================================
# Username for logging into the /dashboard management interface
ADMIN_USERNAME="admin"

# Scrypt password hash in the format: <hex_salt>:<hex_hash>
# Generate a hash for your password with:
# node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');const h=c.scryptSync('your_password',s,64).toString('hex');console.log(s+':'+h);"
ADMIN_PASSWORD_HASH="salt_hex_string:hash_hex_string"

# Session JWT Signing Key (Must be at least 32 characters long)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="your_session_jwt_secret_must_be_at_least_32_characters_long"

# ==========================================
# 5. Application & Runtime Configuration
# ==========================================
# Base URL for the Next.js application
APP_BASE_URL="http://localhost:3000"

# Node environment: development | test | production
NODE_ENV="development"

# ==========================================
# 6. n8n Automation Workflows (Bonus / Optional)
# ==========================================
# n8n Free Tier / Community Edition compatible.
# No paid n8n API Key is required. These workflows use standard Webhooks and HTTP Requests.

# Target webhook URL if your application notifies n8n of new order events
N8N_WEBHOOK_URL="http://localhost:5678/webhook/order-sync"

# Incident / Alerting webhook URL used by n8n/error-notification-workflow.json
# (e.g. Free Slack Incoming Webhook, Discord Webhook, or any custom endpoint)
INCIDENT_ALERT_WEBHOOK_URL="https://hooks.slack.com/services/REPLACE/WITH/YOUR/WEBHOOK"
